# Managed by llm-api-config. Copy/inject values into .env.local; never commit it.
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
AUTORESEARCH_DATA_DIR=var
AUTORESEARCH_DB_PATH=var/autoresearch.sqlite3
AUTORESEARCH_CHECKPOINT_PATH=var/checkpoints.sqlite3
AUTORESEARCH_PROJECTS_DIR=paper-projects
AUTORESEARCH_TEMPLATE_DIR=paper-projects/_template
AUTORESEARCH_NETWORK_ENABLED=false
